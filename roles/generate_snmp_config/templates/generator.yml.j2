auths:
  public_v2:
    security_level: authNoPriv
    auth_protocol: SHA
    username: {{ generate_snmp_config_snmp_username | to_json }}
    password: {{ generate_snmp_config_snmp_password | to_json }}
    version: 3
modules:
  {{ generate_snmp_config_snmp_exporter_module_name }}:
    timeout: 20s
    walk:
      - sysUpTime
      - interfaces
      - ifXTable
